#------------------------------------------------------------------------------
#--- VARIABLES
#------------------------------------------------------------------------------
GREEN='\033[0;32m'
RED='\033[0;31m'
NON='\033[0m'
STNDOUT="/dev/ttymxc1"
COMMAND="$(basename "$0")"
LOGSTATUS="VERBOSE"
DEV="/dev/video0"
#------------------------------------------------------------------------------
#--- USAGE Instruction
#------------------------------------------------------------------------------
usage="###############################################################
$(basename "$0") HELP
  you can use only the followig entries
	$COMMAND --help
	$COMMAND			

###############################################################"
#------------------------------------------------------------------------------
#--- FUNCTIONs
#------------------------------------------------------------------------------
function greenprint()
{
        echo -e "${GREEN}$1${NON}" > $STNDOUT
}
#------------------------------------------------------------------------------
function redprint()
{
        echo -e "${RED}$1${NON}" > $STNDOUT
}
#------------------------------------------------------------------------------
function logprint()
{
        if [[ "$LOGSTATUS" == VERBOSE ]]; then
                echo -e "LOG: ${NON}$1${NON}" > $STNDOUT
        fi
}
#------------------------------------------------------------------------------
function main ()
{
	case $1 in
		--help|help)
			redprint "$usage" 
			exit 0
		;;

		*)
			echo "" > $STNDOUT 
			greenprint "$COMMAND: launch GSTREAMER acquisition ... "
			
			if [ -e "$DEV" ]; then
				gst-launch-1.0 -v v4l2src device=/dev/video0 ! "video/x-raw,format=YUY2,width=1280,height=800" ! queue ! waylandsink > $STNDOUT 
			else
				redprint "Camera not found"
			fi

			shift
		;;
	esac
}
#------------------------------------------------------------------------------
#--- MAIN
#------------------------------------------------------------------------------
PARAM1="$1"

main "$PARAM1"
