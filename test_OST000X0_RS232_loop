#------------------------------------------------------------------------------ 
#--- VARIABLES                                                                  
#------------------------------------------------------------------------------ 
GREEN='\033[0;32m'                                                              
RED='\033[0;31m'                                                                
NON='\033[0m'                                                                   
STNDOUT="/dev/tty"                                                              
COMMAND="$(basename "$0")"                                                      
BAUDRATE="115200"                                                               
NAME="lpuart6, lpuart7 in RS232 rts/cts setup"
PORT1="/dev/ttyLP5"		# RS232_1	lpuart6
PORT2="/dev/ttyLP6"		# RS232_2	lpuart7
TESTPATTERN="/root/test-mas/tp_rs232_8k.txt"
FILE1="/root/test-mas/receivedLP5.txt"
FILE2="/root/test-mas/receivedLP6.txt"                                   
#------------------------------------------------------------------------------ 
#--- USAGE Instruction                                                          
#------------------------------------------------------------------------------ 
usage="###############################################################         
$(basename "$0") HELP                                                          
  you can use only the followig entries                                        
        $COMMAND --help                                                         
        $COMMAND <without any argument>                                         
  Use this command to test $NAME.
  These serials are required to be cross-connected for the test.                                                
  Default baudrate is $BAUDRATE.                                                
###############################################################"                
#------------------------------------------------------------------------------ 
#--- FUNCTIONs                                                                  
#------------------------------------------------------------------------------ 
function greenprint()                                                           
{                                                                               
        echo -e "${GREEN}$1${NON}" > $STNDOUT                                   
}                                                                               
#------------------------------------------------------------------------------ 
function redprint()                                                             
{                                                                              
        echo -e "${RED}$1${NON}" > $STNDOUT                                    
}                                                                              
#------------------------------------------------------------------------------
function main ()                                                               
{                                                                              
        case $1 in                                                             
                --help|help)                                                   
					redprint "$usage"                                       
                    exit 0                                                  
                ;;
                                                              
                *)                                                              
					greenprint "############################################"
                    greenprint "$COMMAND ... "                                                                 
                    FLD=$(ls /root | grep test-mas)      
                    echo ""
                    
					rm -f $FILE1 $FILE2
                               
					echo -e  "Configure ports baudrate:           $BAUDRATE"
					stty -F "$PORT1" "$BAUDRATE" sane raw crtscts -echo
					stty -F "$PORT2" "$BAUDRATE" sane raw crtscts -echo

					echo -e  "File data pattern:                  $TESTPATTERN"
					echo ""
					
					echo "Transmission data file to the UARTs crossed lines..."
					echo ""
					cat $PORT1 > $FILE1 &			
					cat $PORT2 > $FILE2 &	

					cat "$TESTPATTERN" > $PORT1
					sleep 1
					
					cat "$TESTPATTERN" > $PORT2
					sleep 1				    

					killall cat

					echo -e  "Checking the md5 checksum of received files the original test pattern:"
					echo ""
					md5sum $TESTPATTERN $FILE1 $FILE2  > $STNDOUT
					echo ""
					
					if [[ $(md5sum $TESTPATTERN $FILE1 | awk '{print $1}' | uniq | wc -l) == 1 ]]
					then
						echo -e "TX LPUART6 -> RX LPUART7	  [${GREEN}OK${NON}]"
					else
						echo -e "TX LPUART6 -> RX LPUART7	  [${RED}OK${NON}]"
					fi

					if [[ $(md5sum $TESTPATTERN $FILE2 | awk '{print $1}' | uniq | wc -l) == 1 ]]
					then
						echo -e "TX LPUART7 -> RX LPUART6  	  [${GREEN}OK${NON}]"
					else
						echo -e "TX LPUART7 -> RX LPUART6	  [${RED}OK${NON}]"
					fi
					
					echo ""
					rm -f $FILE1 $FILE2
								                                         
					greenprint "############################################"
					shift                            
                ;;                                                              
        esac                                                                    
}                                                                               
#------------------------------------------------------------------------------ 
#--- MAIN                                                                       
#------------------------------------------------------------------------------ 
PARAM1="$1"                                                                     
                                                                                
main "$PARAM1"                                                                  

