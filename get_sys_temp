#------------------------------------------------------------------------------
#--- VARIABLES
#------------------------------------------------------------------------------
GREEN='\033[0;32m'
RED='\033[0;31m'
NON='\033[0m'
STNDOUT="/dev/tty"
COMMAND="$(basename "$0")"
DEV="/sys/class/thermal/thermal_zone0/"
TRIPP0="trip_point_0_temp"
TRIPP0T="trip_point_0_type"
TRIPP1="trip_point_1_temp"
TRIPP1T="trip_point_1_type"
TEMP="temp"
#------------------------------------------------------------------------------
#--- USAGE Instruction
#------------------------------------------------------------------------------
usage="###############################################################
$(basename "$0") HELP
  you can use only the followig entries
	$COMMAND --help
	$COMMAND <without any argument> 
  USe this command to test RTC $NAME. Try to set system time
  with hwclock command. Power off the system. Then check if the
  time is correct.
###############################################################"
#------------------------------------------------------------------------------
#--- FUNCTIONs
#------------------------------------------------------------------------------
function greenprint()
{
        echo -e "${GREEN}$1${NON}" > $STNDOUT
}
#------------------------------------------------------------------------------
function redprint()
{
        echo -e "${RED}$1${NON}" > $STNDOUT
}
#------------------------------------------------------------------------------
function main ()
{
	case $1 in
    		--help|help)
        		redprint "$usage" 
    			exit 0
    		;;
    		*)
		greenprint "================================================="
		greenprint "$COMMAND: getting thermal info in Celsius Degrees"
		LOWE=$(cat $DEV$TRIPP0)
		LOWE_T=$(cat $DEV$TRIPP0T)
		HIGH=$(cat $DEV$TRIPP1)
		HIGH_T=$(cat $DEV$TRIPP1T)
		TEMP=$(cat $DEV$TEMP)
greenprint "$COMMAND: current max threshold $(( $HIGH/1000)) type $HIGH_T "
greenprint "$COMMAND: current temp $(( $TEMP/1000 ))"
		greenprint "================================================"
        		shift
    		;;
	esac
}
#------------------------------------------------------------------------------
#--- MAIN
#------------------------------------------------------------------------------
PARAM1="$1"

main "$PARAM1"

