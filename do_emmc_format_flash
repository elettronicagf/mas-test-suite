}
#------------------------------------------------------------------------------
function check_mount_device()
{
	# $1 must be /dev/sdX or /dev/mmcblkX block device type
	IS_MOUNTED=$( mount | grep "$1" | awk '{print $1}' | xargs -L1 echo )
	# TODO: ATTENZIONE ricordati di evitare di smontare il rootfs corrente.
	# TODO: aggiungi controllo.
	echo "##################################################################"
	echo "Check if $1 was mounted before"
	echo "##################################################################"
	if [ -z "$IS_MOUNTED" ]
	then
		echo "OK $1 is NOT mounted."
		#var empty
	else
		echo "$1: $IS_MOUNTED. Unmount it before continue!!"
		IS_MOUNTED=$(mount | grep "$1" | awk '{print $1}' | xargs -L1 umount )
		sync
		sleep 2
		echo "$0: Check it AGAIN"
		if [ -z "$IS_MOUNTED" ]
		then
			echo "OK $1 is now unmounted!"
			#var empty
		else
			echo "$1: $IS_MOUNTED. Something went wrong. Abort!"
			exit 0
		fi
	fi
}
#------------------------------------------------------------------------------
function emmc_check_format()
{
	DEVICE="$EMMCDEV"

	# Check if the device exists
	if [ ! -e "$DEVICE" ]; then
		echo "The device $DEVICE does not exist."
		exit 1
	fi

	# Check the partitions in the device
	partitions=$(ls ${DEVICE}p*)
	ext4_partition_found=false

	# Iterate over the partitions
	for partition in $partitions; do
		# Check the file system type of the partition
		fs_type=$(blkid -o value -s TYPE $partition)
		if [ "$fs_type" == "ext4" ]; then
			ext4_partition_found=true
			break
		fi
	done

	# Check if at least one ext4 partition was found
	if $ext4_partition_found; then
		echo "At least one ext4 partition found in $DEVICE." > $STDOUT
		_val="EMMC_FORMATTED"
	else
		echo "No ext4 partitions found in $DEVICE." > $STDOUT
		_val="EMMC_VIRGIN"
	fi
	echo $_val
}
