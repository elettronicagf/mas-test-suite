#------------------------------------------------------------------------------
#--- VARIABLES
#------------------------------------------------------------------------------
GREEN='\033[0;32m'
RED='\033[0;31m'
NON='\033[0m'
STNDOUT="/dev/tty"
COMMAND="$(basename "$0")"
#------------------------------------------------------------------------------
#--- USAGE Instruction
#------------------------------------------------------------------------------
usage="======================================================
$(basename "$0") HELP
  you can use only the followig entries
	$COMMAND --help
	$COMMAND <without any argument> 
  Use this command to test buzzer on trigger board. A user can hear a sound 
 for 1 second to the max available volume.
======================================================"
#------------------------------------------------------------------------------
#--- FUNCTIONs
#------------------------------------------------------------------------------
function greenprint()
{
        echo -e "${GREEN}$1${NON}" > $STNDOUT
}
#------------------------------------------------------------------------------
function redprint()
{
        echo -e "${RED}$1${NON}" > $STNDOUT
}
#------------------------------------------------------------------------------
function main ()
{
	case $1 in
		--help|help)
			redprint "$usage" 
			exit 0
		;;
		*)
			WHICHISEMMC="mmcblk0"
			
			MMCINFO=$(sudo mmc extcsd read /dev/$WHICHISEMMC | head -n 3)
			greenprint "$MMCINFO "
			echo " "

			OUTPUT=$(sudo mmc extcsd read /dev/$WHICHISEMMC | head -n 3)
			REV=$(echo "$OUTPUT" | grep -oP 'Extended CSD rev \K\d+\.\d+')
			NUM=$(echo "$OUTPUT" | grep -oP '\(MMC \K\d+\.\d+')

			if (( $(echo "$REV >= 1.7" | bc -l) )) && (( $(echo "$NUM >= 5.0" | bc -l) )); then
				echo -e "$COMMAND. Rev $REV and mmc version $NUM.   [${GREEN}OK${NON}]"
				STAT1="OK"
			else
				echo -e "$COMMAND. Rev $REV and mmc version $NUM.   [${RED}FAIL${NON}]"
				STAT1="ERROR"
			fi

			PRE_EOL=$(sudo mmc extcsd read /dev/$WHICHISEMMC | grep "eMMC" | sed 's/Firmware.*//' | grep EXT_CSD_PRE_EOL_INFO)
			VAL=$(echo "$PRE_EOL" | awk -F': ' '{print $2}')

			if [ "$VAL" = "0x00" ] || [ "$VAL" = "0x01" ]; then
				echo -e "$COMMAND. Pre EOL        : health good.  [${GREEN}OK${NON}]"
				STAT2="OK"
			else
				echo -e "$COMMAND. Pre EOL        : health bad.   [${RED}FAIL${NON}]"
				STAT2="ERROR"
			fi

			PRE_EOLA=$(sudo mmc extcsd read /dev/$WHICHISEMMC | grep "eMMC" | sed 's/Firmware.*//' | grep EXT_CSD_DEVICE_LIFE_TIME_EST_TYP_A)
			VAL=$(echo "$PRE_EOLA" | awk -F': ' '{print $2}')

			if [ "$VAL" = "0x00" ] || [ "$VAL" = "0x01" ]; then
				echo -e "$COMMAND. Pre EOL Type A : health good.  [${GREEN}OK${NON}]"
				STAT3="OK"
			else
				echo -e "$COMMAND. Pre EOL Type A : health bad.   [${RED}FAIL${NON}]"
				STAT3="ERROR"
			fi

			PRE_EOLB=$(sudo mmc extcsd read /dev/$WHICHISEMMC | grep "eMMC" | sed 's/Firmware.*//' | grep EXT_CSD_DEVICE_LIFE_TIME_EST_TYP_B)
			VAL=$(echo "$PRE_EOLB" | awk -F': ' '{print $2}')

			if [ "$VAL" = "0x00" ] || [ "$VAL" = "0x01" ]; then
				echo -e "$COMMAND. Pre EOL Type B : health good.  [${GREEN}OK${NON}]"
				STAT4="OK"
			else
				echo -e "$COMMAND. Pre EOL Type B : health bad.   [${RED}FAIL${NON}]"
				STAT4="ERROR"
			fi

			INFO=$(sudo cat /sys/kernel/debug/mmc0/ios)
			VDD=$(echo "$INFO" | awk '/vdd:/ {print $2}')
			BUS_WIDTH=$(echo "$INFO" | awk '/bus width:/ {print $3}')
			TIMING_SPEC=$(echo "$INFO" | awk '/timing spec:/ {print $3}')
			SIGNAL_VOLTAGE=$(echo "$INFO" | awk '/signal voltage:/ {print $3}')
			CLOCK=$(echo "$INFO" | grep -w "clock:" | grep -v "actual" | grep -oP 'clock:\s*\K[0-9]+')
			#ACTUAL_CLOCK=$(echo "$INFO" | grep -oP 'actual clock:\s*\K[0-9]+')
			CK_REF="200000000"

			if [ "$VDD" -eq 21 ] && [ "$BUS_WIDTH" -eq 3 ] && [ "$TIMING_SPEC" -eq 10 ] && [ "$SIGNAL_VOLTAGE" -eq 1 ]; then
				echo -e "eMMC info are ok.                             [${GREEN}OK${NON}]"
				STAT5="OK"
			else
				echo -e "eMMC info mismatch.                           [${RED}FAIL${NON}]"
				sudo cat /sys/kernel/debug/mmc0/ios
				STAT5="ERROR"
			fi


			if [ "$CLOCK" -eq "$CK_REF" ]; then
				echo -e "eMMC clocks are equal to $CK_REF Hz.        [${GREEN}OK${NON}]"
				STAT6="OK"
			else
				echo -e "eMMC clock mismatch.                          [${RED}FAIL${NON}]"
				sudo cat /sys/kernel/debug/mmc0/ios
				STAT6="ERROR"
			fi

			SIZE=$(dmesg | grep mmcblk0 | grep GiB | awk '{print $6}')

			if (( $(echo "$SIZE >= 3 && $SIZE <= 4" | bc -l) )); then
				echo -e "eMMC size $WHICHISEMMC is $SIZE. Close to 4GB.      [${GREEN}OK${NON}]"
				STAT7="OK"
			else
				echo -e "eMMC size $WHICHISEMMC is $SIZE. Mismatch.          [${RED}FAIL${NON}]"
				STAT7="ERROR"
			fi

			# Final Check
			if [ "$STAT1" != "OK" ] || [ "$STAT2" != "OK" ] || [ "$STAT3" != "OK" ] || \
			   [ "$STAT4" != "OK" ] || [ "$STAT5" != "OK" ] || [ "$STAT6" != "OK" ] || \
			   [ "$STAT7" != "OK" ]; then
				echo ""
				redprint "TEST FAIL"
				exit 0
			else
				echo ""
				greenprint "TEST OK"
				exit 1
			fi
			;;
	esac
}
#------------------------------------------------------------------------------
#--- MAIN
#------------------------------------------------------------------------------
PARAM1="$1"
main "$PARAM1"
