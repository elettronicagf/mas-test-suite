#------------------------------------------------------------------------------
#--- VARIABLES
#------------------------------------------------------------------------------
GREEN='\033[0;32m'
RED='\033[0;31m'
NON='\033[0m'
STNDOUT="/dev/tty"
COMMAND="$(basename "$0")"
LOGSTATUS="VERBOSE"
CLEAR_SCREEN='\033[2J'
CURS_POS='\033[1;1f'
CURS_UP='\033[1A'
CURS_DO='\033[1B'
CURS_FW='\033[2C'
CURS_BW='\033[1D'
GET_CUR_POS="\033[6n"
DEV="EEPROM_SOM_I2C3"
DEVPATH="/sys/devices/platform/soc@0/42000000.bus/426b0000.i2c/i2c-4/4-0050/uevent"
#------------------------------------------------------------------------------
#--- USAGE Instruction
#------------------------------------------------------------------------------
usage="###############################################################
$(basename "$0") HELP
  you can use only the followig entries
	$COMMAND --help

###############################################################"
#------------------------------------------------------------------------------
#--- FUNCTIONs
#------------------------------------------------------------------------------
function greenprint()
{
	echo -e "${GREEN}$1${NON}" > $STNDOUT
}
#------------------------------------------------------------------------------
function redprint()
{
	echo -e "${RED}$1${NON}" > $STNDOUT
}
#------------------------------------------------------------------------------
function logprint()
{
	if [[ "$LOGSTATUS" == VERBOSE ]]; then
		echo -e "LOG: ${NON}$1${NON}" > $STNDOUT
	fi
}
#------------------------------------------------------------------------------
function main ()
{
	case $1 in
		--help|help)
			redprint "$usage" 
			exit 0
			;;

    	*)	
			echo ""
			cat $DEVPATH > $STNDOUT
			echo ""
			
			OFFSET=$((1 + $RANDOM % 1000))
			
			greenprint "testdeveeprom test $DEV $OFFSET"
			echo ""
			/root/test-mas/testdeveeprom test $DEV $OFFSET > $STNDOUT

			# erase the test pattern on eeprom
			/root/test-mas/testdeveeprom erase $DEV $OFFSET >/dev/null 2>/dev/null
			shift
			;;
	esac
}
#------------------------------------------------------------------------------
#--- MAIN
#------------------------------------------------------------------------------
PARAM1="$1"

main "$PARAM1"
